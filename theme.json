{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"title": "Blocklane",
	"slug": "blocklane",
	"description": "A versatile, production-grade WordPress Full Site Editing block theme built on core blocks, a brand-role design token system with derived color ramps, and WCAG 2.1 Level AA foundations.",
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"radiusSizes": [
				{
					"slug": "none",
					"name": "None",
					"size": "0"
				},
				{
					"slug": "sm",
					"name": "Small",
					"size": "4px"
				},
				{
					"slug": "md",
					"name": "Medium",
					"size": "8px"
				},
				{
					"slug": "lg",
					"name": "Large",
					"size": "12px"
				},
				{
					"slug": "full",
					"name": "Full",
					"size": "9999px"
				}
			]
		},
		"viewport": {
			"mobile": "480px",
			"tablet": "768px"
		},
		"color": {
			"background": true,
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"text": true,
			"gradients": [
				{
					"slug": "brand-sweep",
					"name": "Brand Sweep",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--accent) 100%)"
				},
				{
					"slug": "primary-sweep",
					"name": "Primary Sweep",
					"gradient": "linear-gradient(45deg, color-mix(in oklab, var(--wp--preset--color--primary), black 10%) 0%, var(--wp--preset--color--primary) 100%)"
				},
				{
					"slug": "deep-brand",
					"name": "Deep Brand",
					"gradient": "linear-gradient(135deg, var(--wp--preset--color--contrast) 0%, color-mix(in srgb, var(--wp--preset--color--primary) 55%, var(--wp--preset--color--contrast)) 100%)"
				},
				{
					"slug": "soft-wash",
					"name": "Soft Wash",
					"gradient": "linear-gradient(180deg, var(--wp--preset--color--subtle) 0%, var(--wp--preset--color--base) 100%)"
				},
				{
					"slug": "subtle-rise",
					"name": "Subtle Rise",
					"gradient": "linear-gradient(0deg, var(--wp--preset--color--subtle) 0%, var(--wp--preset--color--base) 55%)"
				},
				{
					"slug": "primary-glow",
					"name": "Primary Glow",
					"gradient": "radial-gradient(ellipse 80% 60% at 50% 0%, color-mix(in srgb, var(--wp--preset--color--primary) 14%, var(--wp--preset--color--base)) 0%, var(--wp--preset--color--base) 70%)"
				},
				{
					"slug": "accent-glow",
					"name": "Accent Glow",
					"gradient": "radial-gradient(ellipse 80% 60% at 50% 0%, color-mix(in srgb, var(--wp--preset--color--accent) 16%, var(--wp--preset--color--base)) 0%, var(--wp--preset--color--base) 70%)"
				}
			],
			"palette": [
				{
					"slug": "base",
					"name": "Base",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "Contrast",
					"color": "#051438"
				},
				{
					"slug": "subtle",
					"name": "Subtle",
					"color": "#f2f5fa"
				},
				{
					"slug": "muted",
					"name": "Muted",
					"color": "#475467"
				},
				{
					"slug": "outline",
					"name": "Border",
					"color": "#eaecf0"
				},
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#1a58e4"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "#0b3083"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#006646"
				}
			]
		},
		"lightbox": {
			"allowEditing": true,
			"enabled": true
		},
		"layout": {
			"allowCustomContentAndWideSize": true,
			"allowEditing": true,
			"contentSize": "48rem",
			"wideSize": "80rem"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "xx-small",
					"name": "XX-Small",
					"shadow": "0 1px 2px rgba(16, 24, 40, 0.05)"
				},
				{
					"slug": "x-small",
					"name": "X-Small",
					"shadow": "0 1px 3px rgba(16, 24, 40, 0.1), 0 1px 2px rgba(16, 24, 40, 0.06)"
				},
				{
					"slug": "small",
					"name": "Small",
					"shadow": "0 4px 8px -2px rgba(16, 24, 40, 0.1), 0 2px 4px -2px rgba(16, 24, 40, 0.06)"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"shadow": "0 12px 16px -4px rgba(0, 0, 0, 0.08), 0 4px 6px -2px rgba(16, 24, 40, 0.03)"
				},
				{
					"slug": "large",
					"name": "Large",
					"shadow": "0 20px 24px -4px rgba(0, 0, 0, 0.08), 0 8px 8px -4px rgba(16, 24, 40, 0.03)"
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"shadow": "0 24px 48px -12px rgba(16, 24, 40, 0.18)"
				},
				{
					"slug": "xx-large",
					"name": "XX-Large",
					"shadow": "0 32px 64px -12px rgba(16, 24, 40, 0.14)"
				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "Tiny",
					"size": "0.25rem"
				},
				{
					"slug": "20",
					"name": "XX-Small",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "X-Small",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "Small",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "Medium",
					"size": "2rem"
				},
				{
					"slug": "60",
					"name": "Large",
					"size": "clamp(2.25rem, 2rem + 1.25vw, 3rem)"
				},
				{
					"slug": "70",
					"name": "X-Large",
					"size": "clamp(2.75rem, 2.33rem + 2.08vw, 4rem)"
				},
				{
					"slug": "80",
					"name": "XX-Large",
					"size": "clamp(3.25rem, 2.67rem + 2.92vw, 5rem)"
				},
				{
					"slug": "90",
					"name": "Huge",
					"size": "clamp(3.75rem, 3rem + 3.75vw, 6rem)"
				},
				{
					"slug": "100",
					"name": "X-Huge",
					"size": "clamp(4.5rem, 3.67rem + 4.17vw, 7rem)"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textAlign": true,
			"textColumns": false,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": true,
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.875rem",
					"fluid": false
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem",
					"fluid": false
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.125rem",
					"fluid": {
						"min": "1.0625rem",
						"max": "1.125rem"
					}
				},
				{
					"slug": "x-large",
					"name": "X-Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "heading-small",
					"name": "Heading Small",
					"size": "1.5rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "heading-medium",
					"name": "Heading Medium",
					"size": "1.875rem",
					"fluid": {
						"min": "1.625rem",
						"max": "1.875rem"
					}
				},
				{
					"slug": "heading-large",
					"name": "Heading Large",
					"size": "2.25rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.25rem"
					}
				},
				{
					"slug": "heading-x-large",
					"name": "Heading X-Large",
					"size": "3rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3rem"
					}
				},
				{
					"slug": "heading-xx-large",
					"name": "Heading XX-Large",
					"size": "3.75rem",
					"fluid": {
						"min": "2.5rem",
						"max": "3.75rem"
					}
				},
				{
					"slug": "heading-xxx-large",
					"name": "Heading XXX-Large",
					"size": "4.5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.5rem"
					}
				}
			],
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Sans (System)",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Serif (System)",
					"fontFamily": "ui-serif, Georgia, \"Times New Roman\", serif"
				},
				{
					"slug": "mono",
					"name": "Mono (System)",
					"fontFamily": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
				},
				{
					"slug": "inter",
					"name": "Inter",
					"fontFamily": "\"Inter\", system-ui, -apple-system, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Inter",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-wght-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "lora",
					"name": "Lora",
					"fontFamily": "\"Lora\", ui-serif, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Lora",
							"fontStyle": "normal",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/lora-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Lora",
							"fontStyle": "italic",
							"fontWeight": "400 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/lora-latin-wght-italic.woff2"
							]
						}
					]
				},
				{
					"slug": "jetbrains-mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, Menlo, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono-latin-wght-normal.woff2"
							]
						}
					]
				}
			]
		},
		"custom": {
			"gutter": "clamp(1rem, 0.636rem + 1.818vw, 2rem)",
			"button": {
				"padding": {
					"x": "1.125rem",
					"y": "0.625rem"
				}
			}
		}
	},
	"styles": {
		"css": "body { overflow-wrap: break-word; }",
		"background": {
			"backgroundSize": "cover"
		},
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)",
			"padding": {
				"top": "0px",
				"right": "var(--wp--custom--gutter)",
				"bottom": "0px",
				"left": "var(--wp--custom--gutter)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.5",
			"letterSpacing": "0"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-700)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"border": {
						"radius": "var(--wp--preset--border-radius--sm)"
					},
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px",
						"style": "solid",
						"width": "3px"
					}
				},
				":active": {
					"color": {
						"text": "var(--wp--preset--color--primary-700)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "var(--wp--preset--border-radius--md)"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"shadow": "var(--wp--preset--shadow--xx-small)",
				"spacing": {
					"padding": {
						"top": "var(--wp--custom--button--padding--y)",
						"right": "var(--wp--custom--button--padding--x)",
						"bottom": "var(--wp--custom--button--padding--y)",
						"left": "var(--wp--custom--button--padding--x)"
					}
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600",
					"lineHeight": "1.5"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-700)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--primary-700)",
						"text": "var(--wp--preset--color--base)"
					},
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px",
						"style": "solid",
						"width": "3px"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--primary-700)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-xx-large)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.2"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-x-large)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-large)",
					"fontWeight": "600",
					"letterSpacing": "-0.02em",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-medium)",
					"fontWeight": "600",
					"letterSpacing": "0",
					"lineHeight": "1.2"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-small)",
					"fontWeight": "600",
					"letterSpacing": "0",
					"lineHeight": "1.2"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "600",
					"letterSpacing": "0",
					"lineHeight": "1.2"
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"lineHeight": "1.5"
				}
			},
			"cite": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontStyle": "normal"
				}
			}
		},
		"blocks": {
			"core/heading": {
				"css": ":first-child { margin-block-start: 0; }"
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--preset--border-radius--md)"
				}
			},
			"core/button": {
				"border": {
					"radius": "var(--wp--preset--border-radius--md)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				},
				"variations": {
					"outline": {
						"border": {
							"color": "currentColor",
							"style": "solid",
							"width": "2px"
						},
						"spacing": {
							"padding": {
								"top": "calc(var(--wp--custom--button--padding--y) - 2px)",
								"right": "calc(var(--wp--custom--button--padding--x) - 2px)",
								"bottom": "calc(var(--wp--custom--button--padding--y) - 2px)",
								"left": "calc(var(--wp--custom--button--padding--x) - 2px)"
							}
						}
					}
				}
			},
			"core/buttons": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--30)"
				}
			},
			"core/columns": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--50)"
				}
			},
			"core/column": {
				"spacing": {
					"padding": {
						"top": "0",
						"right": "0",
						"bottom": "0",
						"left": "0"
					}
				}
			},
			"core/cover": {
				"color": {
					"text": "var(--wp--preset--color--base)"
				},
				"dimensions": {
					"minHeight": "clamp(360px, 60vh, 600px)"
				},
				"css": "& { min-height: clamp(360px, 60dvh, 600px); }"
			},
			"core/separator": {
				"border": {
					"bottom": {
						"color": "var(--wp--preset--color--outline)",
						"style": "solid",
						"width": "1px"
					}
				},
				"color": {
					"text": "var(--wp--preset--color--outline)"
				}
			},
			"core/list": {
				"css": "padding-inline-start: var(--wp--preset--spacing--40);"
			},
			"core/list-item": {
				"spacing": {
					"margin": {
						"bottom": "var(--wp--preset--spacing--20)"
					}
				}
			},
			"core/quote": {
				"css": "border-inline-start: 4px solid var(--wp--preset--color--primary); padding-inline-start: var(--wp--preset--spacing--40);",
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontStyle": "italic",
					"lineHeight": "1.6"
				}
			},
			"core/pullquote": {
				"border": {
					"top": {
						"color": "var(--wp--preset--color--outline)",
						"style": "solid",
						"width": "2px"
					},
					"bottom": {
						"color": "var(--wp--preset--color--outline)",
						"style": "solid",
						"width": "2px"
					}
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--heading-large)",
					"fontWeight": "600",
					"lineHeight": "1.3"
				}
			},
			"core/table": {
				"css": "border-collapse: collapse; width: 100%;"
			},
			"core/code": {
